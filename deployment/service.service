# systemd unit for Akupara. Update user and paths before installation.

[Unit]
Description=Akupara
After=network.target

[Service]
Type=simple
User=yourusername
WorkingDirectory=/path/to/Akupara
ExecStart=/path/to/Akupara/.venv/bin/python src/main.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
