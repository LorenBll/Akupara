# Akupara Configuration
# Port settings are managed in resources/configuration.json.

# Registered users, as a JSON list of {"username", "password", "admin"}
# where password is the Argon2id hash of the real password (salt: akupara-salt,
# m=65536, t=2, p=1; regenerate it with scripts/generate-password-hash.js), and
# admin is a boolean (default false) marking whether the user is an administrator.
# Users log in through the login page; to make a user an admin, list them here
# with "admin": true.
USERS=[]

# When true, internal interactions are enabled (plugins can interact internally).
# Accepted values: true / false
INTERNAL_INTERACTIONS=false

# When true, the API keys functionality is enabled.
# Accepted values: true / false
API_KEYS_ENABLED=false

# When true, the "report issues" promotion line is displayed at the bottom.
# Accepted values: true / false
DISPLAY_PROMOTION=true

# List of API keys, as a JSON list of {"name", "key", "id"} where key is the
# Fernet-encrypted form of the real API key (see API_KEY_ENCRYPTION_KEY below).
# The server decrypts keys on the fly so the UI can display and copy them.
# id is a random secret (secrets.token_hex(16), never changed) used only to
# attribute changes in the logs.
API_KEYS=[]

# Fernet key used to encrypt and decrypt the API keys stored in API_KEYS above.
# Losing it makes the stored keys undecryptable; keep it safe.
# Generated automatically on first run if not set and no API keys are stored.
API_KEY_ENCRYPTION_KEY=
SHARED_MEMORY=[]
PLAY_AUDIOS=true
SHARED_MEMORY_ENABLED=false
ACKNOWLEDGE_SOUND=acknowledge.wav
WARN_SOUND=warn.wav
PROCESS_SOUND=process.wav
SUCCESS_SOUND=success.wav
ERROR_SOUND=error.wav
EXTERNAL_INTERACTIONS=false
AUTOMATIC_UPDATE=false
# Incoming firewall entries, as a JSON list of {"ip", "plugins", "action", "Note"}
# where plugins is a list of plugin names ("akupara" blocks the IP from the
# Akupara workers, and therefore from all plugins), action is one of
# allow / unknown / block, and Note is free text.
EXTERNAL_INTERACTIONS_INCOMING_IPS=[]
# Outgoing firewall entries, same shape as above.
EXTERNAL_INTERACTIONS_OUTGOING_IPS=[]
EXTERNAL_INTERACTIONS_ALLOW_NEW=false
# When true, outgoing requests not matching any entry are let through.
# Accepted values: true / false
EXTERNAL_INTERACTIONS_ALLOW_NEW_OUTGOING=false
PLAY_LOG_SOUNDS=false
# When true, the startup sound (logo-reveal.wav) is played after loading.
# Takes effect only when PLAY_AUDIOS is true.
# Accepted values: true / false
PLAY_STARTUP_SOUND=true
AUTOMATIC_PLUGIN_LIBRARY_UPDATE=false
AUTOMATIC_PLUGIN_UPGRADE=false
PLUGIN_EVENT_SUBSCRIPTIONS={}
# Optional GitHub token to increase the GitHub API rate limit. When set,
# Akupara sends every GitHub API request with this token first (via
# ``Authorization: token <TOKEN>``) without trying unauthenticated first.
# If the token-authenticated request is rate limited, Akupara retries the
# same request without the token. If that is also rate limited (and ONLY
# in that case), version checks are silently skipped so Akupara keeps
# running as usual; operations that actually need GitHub data log an error
# but do not crash the process.
# No specific permissions are required for the token — generate it at
# https://github.com/settings/tokens (classic) or
# https://github.com/settings/personal-access-tokens/new (fine-grained) with
# no scopes/permissions selected, and ideally with no expiration date — the
# absence of an expiration date does not compromise security when the token
# has no permissions.
# GITHUB_TOKEN=
