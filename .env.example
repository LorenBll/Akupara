# Akupara Configuration
# Port settings are managed in resources/configuration.json.

# Username and password required to log in through the login page.
# PASSWORD is the Argon2id hash of the real password (salt: akupara-salt,
# m=65536, t=2, p=1). Regenerate it with scripts/generate-password-hash.js.
# This is a non-admin account; to make the user an admin, list them in USERS with "admin": true.

# Registered users, as a JSON list of {"username", "password", "admin"}
# where password is the same Argon2id hash format as PASSWORD above, and admin is
# a boolean (default false) marking whether the user is an administrator.
USERS=[]

# When true, internal interactions are enabled (plugins can interact internally).
# Accepted values: true / false
INTERNAL_INTERACTIONS=false

# When true, the API keys functionality is enabled.
# Accepted values: true / false
API_KEYS_ENABLED=false

# When true, the "report issues" promotion line is displayed at the bottom.
# Accepted values: true / false
DISPLAY_PROMOTION=true

# List of API keys, as a JSON list of {"name", "key", "id"} where key is the
# Fernet-encrypted form of the real API key (see API_KEY_ENCRYPTION_KEY below).
# The server decrypts keys on the fly so the UI can display and copy them.
# id is a random secret (secrets.token_hex(16), never changed) used only to
# attribute changes in the logs.
API_KEYS=[]

# Fernet key used to encrypt and decrypt the API keys stored in API_KEYS above.
# Losing it makes the stored keys undecryptable; keep it safe.
# Generated automatically on first run if not set and no API keys are stored.
API_KEY_ENCRYPTION_KEY=
SHARED_MEMORY=[]
PLAY_AUDIOS=true
SHARED_MEMORY_ENABLED=false
ACKNOWLEDGE_SOUND=acknowledge.wav
WARN_SOUND=warn.wav
PROCESS_SOUND=process.wav
SUCCESS_SOUND=success.wav
ERROR_SOUND=error.wav
EXTERNAL_INTERACTIONS=false
AUTOMATIC_UPDATE=false
EXTERNAL_INTERACTIONS_IPS=[]
EXTERNAL_INTERACTIONS_ALLOW_NEW=false
PLAY_LOG_SOUNDS=false
# When true, the startup sound (logo-reveal.wav) is played after loading.
# Takes effect only when PLAY_AUDIOS is true.
# Accepted values: true / false
PLAY_STARTUP_SOUND=true
AUTOMATIC_PLUGIN_LIBRARY_UPDATE=false
AUTOMATIC_PLUGIN_UPGRADE=false
PLUGIN_EVENT_SUBSCRIPTIONS={}
