# Akupara Configuration
# Port settings are managed in resources/configuration.json.

# Username and password required to log in through the login page.
# PASSWORD is the Argon2id hash of the real password (salt: akupara-salt,
# m=65536, t=2, p=1). Regenerate it with scripts/generate-password-hash.js.
# This legacy pair has no "admin" flag, so it is a non-admin account; to make a
# user an admin, list them in USERS with "admin": true.
USERNAME=
PASSWORD=

# Additional registered users, as a JSON list of {"username", "password", "admin", "root", "id"}
# where password is the same Argon2id hash format as PASSWORD above, admin is
# a boolean (default false) marking whether the user is an administrator, root is
# a boolean (default false) marking the single root user (not editable via the API;
# the root user cannot be demoted or deleted), and id is a secret hash used only to
# attribute changes in the logs (never exposed to the UI, never changed).
# Usernames are matched case-insensitively. USERS entries take precedence over the
# USERNAME/PASSWORD pair for the same username. USERNAME/PASSWORD above remain as
# the first user.
# Example: USERS=[{"username": "alice", "password": "$argon2id$...", "admin": true, "root": true, "id": "<hash>"}, {"username": "bob", "password": "$argon2id$...", "admin": false, "root": false, "id": "<hash>"}]
USERS=[]

# When true, internal interactions are enabled (plugins can interact internally).
# Accepted values: true / false
INTERNAL_INTERACTIONS=false

# When true, the API keys functionality is enabled.
# Accepted values: true / false
API_KEYS_ENABLED=false

# When true, the shared memory functionality is enabled.
# Accepted values: true / false
SHARED_MEMORY_ENABLED=true

# When true, plugins are allowed to interact with the network.
# Accepted values: true / false
NETWORK_INTERACTIONS=false

# When true, Akupara is reachable from other devices on the network (and outside),
# via an external-access worker bound to the device's IP on the same port.
# Accepted values: true / false
EXTERNAL_ACCESS=false

# When true, Akupara automatically updates to the latest version.
# Accepted values: true / false
AUTOMATIC_UPDATE=false

# List of IPs that interact with the network worker, as a JSON list of
# dictionaries where each dictionary maps an IP (IPv4 or IPv6) to one of:
# "allow" (requests pass through), "unknown" (decided by
# NETWORK_ACCESS_ALLOW_NEW) or "block" (requests are refused), and optionally
# carries a "Note" key whose string value stores a note about that IP entry.
# Example: NETWORK_ACCESS_IPS=[{"192.168.1.10": "allow", "Note": "Office router"}, {"2001:db8::1": "block", "Note": ""}]
NETWORK_ACCESS_IPS=[]

# What the network worker does with requests from IPs whose value in
# NETWORK_ACCESS_IPS is "unknown" and from IPs not yet in the list.
# New IPs are always recorded in the list with the value "unknown".
# true: such requests pass through.
# false: such requests are refused.
# Accepted values: true / false
NETWORK_ACCESS_ALLOW_NEW=false

# When true, the "report issues" promotion line is displayed at the bottom.
# Accepted values: true / false
DISPLAY_PROMOTION=true

# List of API keys, as a JSON list of {"name", "key", "id"} where key is the
# Fernet-encrypted form of the real API key (see API_KEY_ENCRYPTION_KEY).
# The server decrypts keys on the fly so the UI can display and copy them.
# id is a random secret (secrets.token_hex(16), never changed) used only to
# attribute changes in the logs.
# Example: API_KEYS=[{"name": "my-key-1", "key": "<fernet token>", "id": "<id>"}]
API_KEYS=[]

# Fernet key used to encrypt and decrypt the API keys stored in API_KEYS.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_KEY_ENCRYPTION_KEY=

# Audio file to play for each event. Values are file names inside resources/audios.
# An empty value disables the sound for that event.
ACKNOWLEDGE_SOUND=acknowledge.wav
WARN_SOUND=
PROCESS_SOUND=
SUCCESS_SOUND=
ERROR_SOUND=
