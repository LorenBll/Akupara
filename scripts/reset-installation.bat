@echo off
setlocal enabledelayedexpansion

REM Delete the artifacts generated by one installation, so the next run
REM counts as a fresh installation. This does NOT touch .env.example,
REM resources/configuration.json, source files, or the virtual environment.

cd /d "%~dp0.."

echo.
echo Akupara - Reset Installation
echo.

echo Deleting per-installation artifacts...

if exist ".env" (
  del /q ".env"
  echo   deleted .env
) else (
  echo   .env not found, skipping
)

if exist "resources\password-pepper" (
  del /q "resources\password-pepper"
  echo   deleted resources\password-pepper
) else (
  echo   resources\password-pepper not found, skipping
)

if exist "resources\installation.json" (
  del /q "resources\installation.json"
  echo   deleted resources\installation.json
) else (
  echo   resources\installation.json not found, skipping
)

if exist "resources\trust" (
  rmdir /s /q "resources\trust"
  echo   deleted resources\trust\
) else (
  echo   resources\trust not found, skipping
)

if exist "logs" (
  rmdir /s /q "logs"
  echo   deleted logs\
) else (
  echo   logs not found, skipping
)

echo.
echo ===============================================
echo   Per-installation artifacts removed
echo ===============================================
echo.
echo Next: scripts\setup.bat (creates a new installation)
echo.
pause
endlocal
